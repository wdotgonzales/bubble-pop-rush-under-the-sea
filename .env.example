# Copy to .env (never commit .env) and fill in. Run backend commands from backend/;
# settings are read from this file one level up.

# --- PostgreSQL (your local server) ---
POSTGRES_USER=your_local_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=bubble_pop_rush_db_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
# Signs session tokens. Use a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_long_random_string
ENVIRONMENT=development
# Meta app secret (App settings > Basic). Needed to verify players. If empty, POST /session
# answers 503 on purpose. For local testing any value works with scripts/make_test_signature.py.
FB_APP_SECRET=
# Comma-separated origins allowed to call the API. In production this must be the origin
# the Instant Game is served from (check the browser Network tab on Facebook).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
# Local dev server talks to the API directly; behind nginx (Docker/production) use /api.
VITE_API_BASE_URL=http://localhost:8000
