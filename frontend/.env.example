# Where the backend lives. Copy this file; the copies are not committed.
#
#   frontend/.env              local development (npm run dev)
#   frontend/.env.production   builds (npm run build / npm run pack)
#
# For a build, Vite reads .env.production instead of .env, so there is nothing to switch
# between development and a Facebook build. Docker and CI pass the value as a build argument.
VITE_API_BASE_URL=http://localhost:8000
